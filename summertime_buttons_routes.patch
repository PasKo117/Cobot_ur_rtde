+import importlib.util
+import pathlib
+import sys
+import tempfile
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+class UiRouteTests(unittest.TestCase):
+    def test_gui_save_then_load_uses_same_format(self):
+        # Import the GUI module without creating a Tk window or connecting to robots.
+        ctk = SimpleNamespace(CTk=type('CTk', (), {}),
+                              set_appearance_mode=lambda *_: None,
+                              set_default_color_theme=lambda *_: None)
+        dialogs = SimpleNamespace(CTkMessagebox=lambda **kw: None)
+        root = pathlib.Path(__file__).resolve().parents[1]
+        spec = importlib.util.spec_from_file_location('test_app_module', root / 'app.py')
+        app = importlib.util.module_from_spec(spec)
+        with patch.dict(sys.modules, {'customtkinter': ctk, 'CTkMessagebox': dialogs}):
+            spec.loader.exec_module(app)
+        poses = [[0.1, 0.2, 0.3, 0.0, 0.0, 0.0]]
+        status = SimpleNamespace(set=lambda text: None)
+        commands = []
+        fake = SimpleNamespace(show_error=lambda error: self.fail(str(error)),
+                               action_status_var=status,
+                               submit=lambda action, **kwargs: commands.append((action, kwargs)) or True)
+        with tempfile.TemporaryDirectory() as directory:
+            filename = str(pathlib.Path(directory) / 'route.csv')
+            with patch.object(app.filedialog, 'asksaveasfilename', return_value=filename):
+                app.RobotControlUI._save_poses(fake, poses)
+            with patch.object(app.filedialog, 'askopenfilename', return_value=filename):
+                app.RobotControlUI._load_route(fake, 'diagnost')
+        self.assertEqual(commands, [('replay', {'robot': 'diagnost', 'poses': poses})])
+
+    def test_save_button_stops_manual_control_before_file_dialog(self):
+        ctk = SimpleNamespace(CTk=type('CTk', (), {}),
+                              set_appearance_mode=lambda *_: None,
+                              set_default_color_theme=lambda *_: None)
+        root = pathlib.Path(__file__).resolve().parents[1]
+        spec = importlib.util.spec_from_file_location('test_app_for_save', root / 'app.py')
+        app = importlib.util.module_from_spec(spec)
+        with patch.dict(sys.modules, {'customtkinter': ctk,
+                                      'CTkMessagebox': SimpleNamespace(CTkMessagebox=lambda **kw: None)}):
+            spec.loader.exec_module(app)
+        actions = []
+        fake = SimpleNamespace(paths={'diagnost': [[0.1, 0.2, 0.3, 0, 0, 0]]},
+                               busy=False, manual=True, pending_path_save=None,
+                               control_stop=lambda: actions.append('stop'),
+                               _save_poses=lambda poses: actions.append('dialog'),
+                               show_error=lambda message: self.fail(message))
+        app.RobotControlUI._save_robot_route(fake, 'diagnost')
+        self.assertEqual(actions, ['stop'])
+        self.assertEqual(fake.pending_path_save, fake.paths['diagnost'])
+
+
+if __name__ == '__main__':
+    unittest.main()
