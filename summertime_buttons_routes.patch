+                       + rotation[0][2]*(rotation[1][0]*rotation[2][1]-rotation[1][1]*rotation[2][0]))
+        if abs(determinant - 1) > 0.01:
+            raise ValueError('матрица R имеет неверный определитель')
+        return rotation
+
