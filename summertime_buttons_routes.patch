+import json
+import math
+import queue
+import sys
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import route_io
+from robot_control import Cancelled, RobotWorker
+
+
+class FakeJoystick:
+    def __init__(self, buttons=(), hat=(0, 0)):
+        self.buttons = set(buttons)
+        self.hat = hat
+    def get_numbuttons(self): return 12
+    def get_button(self, index): return int(index in self.buttons)
+    def get_numhats(self): return 1
+    def get_hat(self, index): return self.hat
+    def get_numaxes(self): return 3
+    def get_axis(self, index): return 0.0
+
+
+class FakeControl:
+    def __init__(self):
+        self.speeds = []
+        self.stops = 0
+    def speedL(self, speeds, acceleration, interval):
+        self.speeds.append(speeds)
+    def speedStop(self, acceleration):
+        self.stops += 1
+
+
+class FakeReceive:
+    def getActualTCPPose(self):
+        return [0.1, 0.2, 0.3, 0, 0, 0]
+
+
+class ButtonTests(unittest.TestCase):
+    def setUp(self):
+        self.messages = queue.Queue()
+        self.worker = RobotWorker(queue.Queue(), self.messages, threading.Event(),
+                                  threading.Event(), queue.Queue())
+        self.worker.ctrl = {name: FakeControl() for name in ('surgeon', 'diagnost')}
+        self.worker.recv = {name: FakeReceive() for name in ('surgeon', 'diagnost')}
+        self.worker.joysticks = {'surgeon': FakeJoystick(hat=(1, 0)),
+                                 'diagnost': FakeJoystick(hat=(1, 0))}
+        self.fake_pygame = SimpleNamespace(event=SimpleNamespace(pump=lambda: None))
+        self.patch = patch.dict(sys.modules, {'pygame': self.fake_pygame})
+        self.patch.start()
+        self.addCleanup(self.patch.stop)
+
+    def events(self):
+        return [self.messages.get_nowait() for _ in range(self.messages.qsize())]
+
+    def test_modes_use_calibration_and_disable_diagnost_joystick(self):
+        self.worker.joysticks['surgeon'].buttons = {6}
+        self.worker.manual_step()
+        self.assertEqual(self.worker.mode, 'sync')
+        self.assertEqual(self.worker.ctrl['diagnost'].speeds[-1][2:], [0, 0, 0, 0])
+        self.assertLess(self.worker.ctrl['diagnost'].speeds[-1][0], 0)
+        self.assertIn(('MODE', {'mode': 'sync'}), self.events())
+        self.worker.joysticks['surgeon'].buttons = {7}
+        self.worker.manual_step()
+        self.assertEqual(self.worker.mode, 'async')
+        self.assertEqual(self.worker.ctrl['diagnost'].speeds[-1][0], 0.01)
+
+    def test_invalid_calibration_refuses_sync(self):
+        self.worker.load_calibration = lambda: (_ for _ in ()).throw(ValueError('ошибка R'))
+        self.worker.joysticks['surgeon'].buttons = {6}
+        self.worker.manual_step()
+        self.assertEqual(self.worker.mode, 'async')
+        self.assertTrue(any('ошибка R' in data.get('text', '') for _, data in self.events()))
+
+    def test_record_once_per_press_and_save_requests_file_dialog(self):
+        joystick = self.worker.joysticks['diagnost']
+        joystick.buttons = {10}
+        self.worker.manual_step()
+        self.worker.manual_step()
+        self.assertEqual(len(self.worker.paths['diagnost']), 1)
+        joystick.buttons = set()
+        self.worker.manual_step()
+        joystick.buttons = {10}
+        self.worker.manual_step()
+        self.assertEqual(len(self.worker.paths['diagnost']), 2)
+        joystick.buttons = {9}
+        self.worker.manual = True
+        self.worker.manual_step()
+        self.assertFalse(self.worker.manual)
+        self.assertIn('SAVE_REQUEST', [kind for kind, _ in self.events()])
+        self.assertGreater(self.worker.ctrl['diagnost'].stops, 0)
+
+    def test_second_replay_press_after_release_cancels(self):
+        joystick = self.worker.joysticks['diagnost']
+        joystick.buttons = {11}
+        self.worker.paths['diagnost'] = [[0.1, 0.2, 0.3, 0, 0, 0]]
+
+        def interrupt_move(name, pose, speed, acceleration, cancel_check):
+            joystick.buttons.clear()
+            self.assertFalse(cancel_check())
+            joystick.buttons.add(11)
+            self.assertTrue(cancel_check())
+            raise Cancelled()
+
+        self.worker.move = interrupt_move
+        with self.assertRaises(Cancelled):
+            self.worker.manual_step()
+
+
+class RouteFilesTests(unittest.TestCase):
+    def test_save_and_reload_six_axis_route(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'waypoints.csv'
+            poses = [[0.1, 0.2, 0.3, 0, math.pi, 0], [0.4, 0.5, 0.6, 0.1, 0.2, 0.3]]
+            self.assertEqual(route_io.write_poses(path, poses), 2)
+            self.assertEqual(route_io.read_poses(path), poses)
+
+    def test_legacy_pipe_route_and_bad_file(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'route.txt'
+            path.write_text('0.1|0.2|0.3|0|3.14|0\n', encoding='utf-8')
+            self.assertEqual(route_io.read_poses(path)[0][1], 0.2)
+            path.write_text('0.1|0.2|0.3\n', encoding='utf-8')
+            with self.assertRaisesRegex(ValueError, 'Строка 1'):
+                route_io.read_poses(path)
+
+
+if __name__ == '__main__':
+    unittest.main()
