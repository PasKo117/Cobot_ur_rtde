+        """R maps diagnost -> surgeon; transpose maps velocity back to diagnost."""
+        linear = surgeon_speed[:3]
+        result = [sum(self.calibration[i][axis] * linear[i] for i in range(3))
+                  for axis in range(2)]
+        return result + [0.0, 0.0, 0.0, 0.0]
 
